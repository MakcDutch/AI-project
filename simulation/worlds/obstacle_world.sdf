<?xml version="1.0"?>
<sdf version="1.9">
  <world name="obstacle_world">
    <physics name="1ms" type="ignored"><max_step_size>0.004</max_step_size><real_time_factor>0.25</real_time_factor></physics>
    <gravity>0 0 -9.81</gravity>
    <!-- Match the pinned PX4 default world magnetic field and georeference. -->
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <spherical_coordinates><surface_model>EARTH_WGS84</surface_model><world_frame_orientation>ENU</world_frame_orientation><latitude_deg>47.397971057728974</latitude_deg><longitude_deg>8.546163739800146</longitude_deg><elevation>0</elevation></spherical_coordinates>
    <atmosphere type="adiabatic"/>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>
    <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <scene><ambient>0.6 0.6 0.6 1</ambient><background>0.7 0.8 0.9 1</background><shadows>true</shadows></scene>
    <light name="sun" type="directional"><pose>0 0 10 0 0 0</pose><cast_shadows>true</cast_shadows><diffuse>0.8 0.8 0.8 1</diffuse><specular>0.2 0.2 0.2 1</specular><direction>-0.5 0.1 -0.9</direction></light>
    <model name="ground_plane"><static>true</static><link name="link">
      <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry></collision>
      <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry><material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.45 0.45 0.45 1</diffuse></material></visual>
    </link></model>
    <!-- Front face x=6.0m ENU. Spawn yaw=0: vehicle forward is world +X (east). -->
    <model name="wall"><static>true</static><pose>6.1 0 3 0 0 0</pose><link name="link">
      <collision name="wall_collision"><geometry><box><size>0.2 30 6</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>0.2 30 6</size></box></geometry><material><ambient>0.85 0.3 0.1 1</ambient><diffuse>0.85 0.3 0.1 1</diffuse></material></visual>
      <sensor name="contacts" type="contact"><always_on>true</always_on><update_rate>50</update_rate><contact><collision>wall_collision</collision><topic>/wall_contacts</topic></contact></sensor>
    </link></model>
  </world>
</sdf>
